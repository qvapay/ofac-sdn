# --- Runtime (app/api/route.js) ---
# Multi-list mode (preferred): public R2 URL of manifest.json enumerating all
# lists. List keys resolve relative to this URL, so manifest + list JSONs must
# live in the same public bucket.
LISTS_MANIFEST_URL=

# Single-list fallback: public R2 URL of ofac-entities.json. Used only when
# LISTS_MANIFEST_URL is not set.
OFAC_INDEX_URL=

# --- Import scripts (--upload) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2 object key for the OFAC JSON (default: ofac-entities.json)
R2_KEY=

# Optional: override the OFAC enhanced-XML download URL
OFAC_SDN_XML_URL=
